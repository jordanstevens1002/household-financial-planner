POSTGRES_DB=household_finance
POSTGRES_USER=household_finance
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://household_finance:change-me@postgres:5432/household_finance
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=household-financial-planner
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
ALLOW_DEVELOPMENT_AUTH=false
LOCAL_AUTH_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15
RESET_TOKEN_MINUTES=30
TEMP_PASSWORD_HOURS=24
LOG_LEVEL=INFO
LOG_FORMAT=json
APPSMITH_VERSION=v1.93
